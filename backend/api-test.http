@url=http://localhost:3000/api

### Login correcto
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "prueba@gmail.com",
  "password": "123456"
}

### Contraseña incorrecta
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "prueba@gmail.com",
  "password": "incorrecta"
}

### Usuario inexistente
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "noexiste@gmail.com",
  "password": "123456"
}

### Campos obligatorios vacíos
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "",
  "password": ""
}

### Sin token
GET {{url}}/auth/me

### Token invalido
GET {{url}}/auth/me
Authorization: Bearer token-falso

### Token valido
GET {{url}}/auth/me
Authorization: Bearer eyJpZCI6MSwiZW1haWwiOiJwcnVlYmFAZ21haWwuY29tIiwicm9sIjoiY2xpZW50ZSIsImV4cCI6MTc4OTI1ODMwNn0.Oz8tchRc-8LieyTmpLuQl5ffBnwz2XPkUWu0kfGVWXQ

### Registro correcto
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "Nuevo",
  "apellido": "Usuario",
  "email": "nuevo@gmail.com",
  "password": "123456",
  "telefono": "3804111111"
}

### Email ya registrado
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "Otro",
  "apellido": "Usuario",
  "email": "registro@gmail.com",
  "password": "123456",
  "telefono": "3804222222"
}

### Campos obligatorios vacíos
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "",
  "apellido": "",
  "email": "",
  "password": ""
}

### LOGIN - Sin body
POST {{url}}/auth/login
Content-Type: application/json

### LOGIN - Body null
POST {{url}}/auth/login
Content-Type: application/json

null

### LOGIN - Body array
POST {{url}}/auth/login
Content-Type: application/json

[]

### LOGIN - Email y password no son strings
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": 123,
  "password": true
}

### LOGIN - Email compuesto solo por espacios
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "   ",
  "password": "123456"
}

### LOGIN - Password vacío
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "prueba@gmail.com",
  "password": ""
}

### LOGIN - Email con espacios y mayúsculas
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "  PRUEBA@GMAIL.COM  ",
  "password": "123456"
}

### REGISTER - Body null
POST {{url}}/auth/register
Content-Type: application/json

null

### REGISTER - Sin body
POST {{url}}/auth/register
Content-Type: application/json

### REGISTER - Body array
POST {{url}}/auth/register
Content-Type: application/json

[]

### REGISTER - Campos obligatorios no son strings
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": 123,
  "apellido": true,
  "email": {},
  "password": []
}

### REGISTER - Teléfono no es string
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "Nuevo",
  "apellido": "Usuario",
  "email": "telefono-invalido@gmail.com",
  "password": "123456",
  "telefono": 3804111111
}

### REGISTER - Nombre y apellido compuestos solo por espacios
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "   ",
  "apellido": "   ",
  "email": "espacios@gmail.com",
  "password": "123456"
}

### REGISTER - Email con formato inválido
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "Nuevo",
  "apellido": "Usuario",
  "email": "email-invalido",
  "password": "123456"
}

### REGISTER - Password menor a 6 caracteres
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "Nuevo",
  "apellido": "Usuario",
  "email": "password-corto@gmail.com",
  "password": "12345"
}

### REGISTER - Password mayor a 128 caracteres
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "Nuevo",
  "apellido": "Usuario",
  "email": "password-largo@gmail.com",
  "password": "ppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp"
}

### REGISTER - Nombre mayor a 100 caracteres
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN",
  "apellido": "Usuario",
  "email": "nombre-largo@gmail.com",
  "password": "123456"
}

### REGISTER - Apellido mayor a 100 caracteres
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "Nuevo",
  "apellido": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
  "email": "apellido-largo@gmail.com",
  "password": "123456"
}

### REGISTER - Email mayor a 255 caracteres
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "Nuevo",
  "apellido": "Usuario",
  "email": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee@a.com",
  "password": "123456"
}

### REGISTER - Teléfono mayor a 30 caracteres
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "Nuevo",
  "apellido": "Usuario",
  "email": "telefono-largo@gmail.com",
  "password": "123456",
  "telefono": "1111111111111111111111111111111"
}

### REGISTER - Datos normalizados y teléfono null
POST {{url}}/auth/register
Content-Type: application/json

{
  "nombre": "  Nombre  ",
  "apellido": "  Apellido  ",
  "email": "  NORMALIZADO@GMAIL.COM  ",
  "password": "123456",
  "telefono": null
}


################################################################
### FASE 1 - Validaciones y permisos del catálogo
### Pegar acá los tokens obtenidos con POST /auth/login
### (data.token). El admin necesita rol = 'admin' en la tabla usuarios.
################################################################
@adminToken = PEGAR_TOKEN_ADMIN
@clienteToken = PEGAR_TOKEN_CLIENTE

### Catálogo - GET público (sin token)
GET {{url}}/categorias

### Catálogo - POST sin token (401)
POST {{url}}/categorias
Content-Type: application/json

{ "nombre": "Remeras" }

### Catálogo - POST con token de cliente (403)
POST {{url}}/categorias
Content-Type: application/json
Authorization: Bearer {{clienteToken}}

{ "nombre": "Remeras" }

### Categoría - crear OK (admin)
POST {{url}}/categorias
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nombre": "Remeras" }

### Categoría - sin nombre (400)
POST {{url}}/categorias
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{}

### Categoría - nombre duplicado (409)
POST {{url}}/categorias
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nombre": "Remeras" }

### Categoría - PUT sin campos (400)
PUT {{url}}/categorias/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{}

### Categoría - borrar con productos asociados (409)
DELETE {{url}}/categorias/1
Authorization: Bearer {{adminToken}}

### Id inválido (400)
GET {{url}}/productos/abc

### Color - hex inválido (400)
POST {{url}}/colores
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nombre": "Rojo", "hex": "rojo" }

### Color - OK
POST {{url}}/colores
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nombre": "Rojo", "hex": "#FF0000" }

### Talle - OK
POST {{url}}/talles
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nombre": "M", "orden": 2 }

### Producto - OK
POST {{url}}/productos
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nombre": "Remera básica", "descripcion": "Algodón", "precio": 15999.90, "categoria_id": 1 }

### Producto - datos inválidos (400)
POST {{url}}/productos
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nombre": "Remera", "precio": "abc", "categoria_id": 0, "estado": "x" }

### Producto - precio con 3 decimales (400)
POST {{url}}/productos
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nombre": "Remera", "precio": 10.555, "categoria_id": 1 }

### Producto - categoría inexistente (400, FK)
POST {{url}}/productos
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nombre": "Remera", "precio": 100, "categoria_id": 99999 }

### Variante - OK
POST {{url}}/variantes
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "producto_id": 1, "color_id": 1, "talle_id": 1, "sku": "REM-ROJ-M-001", "stock": 10 }

### Variante - stock negativo (400)
POST {{url}}/variantes
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "producto_id": 1, "color_id": 1, "talle_id": 1, "stock": -1 }

### Método de pago - OK
POST {{url}}/metodos-pago
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "codigo": "tarjeta", "nombre_visible": "Tarjeta de crédito", "activo": true, "orden": 1 }

### Perfil - PUT sin campos (400)
PUT {{url}}/usuarios/me
Content-Type: application/json
Authorization: Bearer {{clienteToken}}

{}

### Perfil - teléfono demasiado largo (400)
PUT {{url}}/usuarios/me
Content-Type: application/json
Authorization: Bearer {{clienteToken}}

{ "telefono": "1234567890123456789012345678901234567890" }
