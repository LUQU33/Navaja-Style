@url=http://localhost:3000/api

### Login correcto
# @name login
POST {{url}}/auth/login
Content-Type: application/json

{
    "email": "nuevo@gmail.com",
    "password": "123456"
}

### Token 
@token = {{login.response.body.data.token}}

### Obtener colores
GET {{url}}/colores 

### Crear color
POST {{url}}/colores
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre": "Color de prueba"
}

### Obtener color por id
GET {{url}}/colores/3
Authorization: Bearer {{token}}

### Actualizar color
PUT {{url}}/colores/5
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre": "Color de prueba actualizado"
}

### Eliminar color
DELETE {{url}}/colores/5
Authorization: Bearer {{token}}